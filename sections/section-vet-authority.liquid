          "default": "check"
        },
        {
          "type": "text",
          "id": "pill_text",
          "label": "Texto",
          "default": "Texto de la pill"
        },
        {
          "type": "color",
          "id": "pill_bg",
          "label": "Color de fondo",
          "default": "#EAF3DE"
        },
        {
          "type": "color",
          "id": "pill_text_color",
          "label": "Color del texto e icono",
          "default": "#3B6D11"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vet Authority",
      "blocks": [
        {
          "type": "trust_pill",
          "settings": {
            "icon": "leaf",
            "pill_text": "7 ingredientes con respaldo cientifico",
            "pill_bg": "#EAF3DE",
            "pill_text_color": "#3B6D11"
          }
        },
        {
          "type": "trust_pill",
          "settings": {
            "icon": "shield-check",
            "pill_text": "Formula revisada por veterinarios DVM",
            "pill_bg": "#E6F1FB",
            "pill_text_color": "#185FA5"
          }
        },
        {
          "type": "trust_pill",
          "settings": {
            "icon": "ban",
            "pill_text": "Sin esteroides ni efectos secundarios",
            "pill_bg": "#FAEEDA",
            "pill_text_color": "#854F0B"
          }
        }
      ]
    }
  ]
}
{% endschema %}
