<style>
  #ing-wrap-01 {
    background-color: #ffffff;
    padding: 56px 20px 64px;
    box-sizing: border-box;
    width: 100%;
  }
  .ing-wrap__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ing-wrap__heading {
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1.25;
    margin: 0 0 40px;
    padding: 0;
    letter-spacing: -0.01em;
  }
  .ing-wrap__heading em {
    font-style: italic;
  }
  .ing-wrap__track {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .ing-wrap__track::-webkit-scrollbar {
    display: none;
  }
  .ing-wrap__grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    align-items: flex-start;
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .ing-wrap__grid {
      flex-wrap: wrap;
    }
  }
  @media (min-width: 1024px) {
    .ing-wrap__track {
      overflow-x: visible;
    }
    .ing-wrap__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding-bottom: 0;
    }
  }
  .ing-wrap__card {
    position: relative;
    background-color: #f5f5f3;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    width: 68vw;
    min-width: 200px;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    list-style: none;
    box-sizing: border-box;
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .ing-wrap__card {
      width: calc(50% - 8px);
      min-width: 220px;
      max-width: none;
      flex-shrink: unset;
    }
  }
  @media (min-width: 1024px) {
    .ing-wrap__card {
      width: auto;
      min-width: unset;
      max-width: none;
      flex-shrink: unset;
    }
  }
  .ing-wrap__card-name {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1a1a1a;
    line-height: 1.35;
    padding: 14px 16px 10px;
    margin: 0;
  }
  .ing-wrap__card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #ededeb;
  }
  .ing-wrap__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .ing-wrap__card-placeholder {
    width: 100%;
    height: 100%;
    background-color: #e5e5e3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ing-wrap__toggle {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #0F6E56;
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.15s ease;
    z-index: 3;
    -webkit-appearance: none;
    appearance: none;
  }
  .ing-wrap__toggle:hover {
    background-color: #1D9E75;
    transform: scale(1.08);
  }
  .ing-wrap__card.is-open .ing-wrap__toggle {
    background-color: #1D9E75;
  }
  .ing-wrap__toggle-icon {
    font-size: 20px;
    font-weight: 300;
    line-height: 1;
    display: block;
  }
  .ing-wrap__card-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s ease, padding-top 0.3s ease, padding-bottom 0.3s ease;
    padding: 0 16px;
    box-sizing: border-box;
  }
  .ing-wrap__card.is-open .ing-wrap__card-body {
    max-height: 500px;
    padding-top: 14px;
    padding-bottom: 52px;
  }
  .ing-wrap__card-body p {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 13px;
    line-height: 1.7;
    color: #444444;
    margin: 0;
    padding: 0;
  }
</style>

<script>
(function () {
  var wrap = document.getElementById('ing-wrap-01');
  if (!wrap) return;
  var cards = Array.prototype.slice.call(wrap.querySelectorAll('[data-ing-card]'));

  function closeCard(card) {
    card.classList.remove('is-open');
    var btn  = card.querySelector('[data-toggle]');
    var icon = card.querySelector('.ing-wrap__toggle-icon');
    var body = card.querySelector('.ing-wrap__card-body');
    if (btn)  btn.setAttribute('aria-expanded', 'false');
    if (body) body.setAttribute('aria-hidden', 'true');
    if (icon) icon.textContent = '+';
  }

  function openCard(card) {
    card.classList.add('is-open');
    var btn  = card.querySelector('[data-toggle]');
    var icon = card.querySelector('.ing-wrap__toggle-icon');
    var body = card.querySelector('.ing-wrap__card-body');
    if (btn)  btn.setAttribute('aria-expanded', 'true');
    if (body) body.setAttribute('aria-hidden', 'false');
    if (icon) icon.textContent = '\u00D7';
  }

  cards.forEach(function (card) {
    var btn = card.querySelector('[data-toggle]');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var wasOpen = card.classList.contains('is-open');
      cards.forEach(closeCard);
      if (!wasOpen) {
        openCard(card);
        if (window.innerWidth < 1024) {
          setTimeout(function () {
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          }, 60);
        }
      }
    });
  });
})();
</script>
