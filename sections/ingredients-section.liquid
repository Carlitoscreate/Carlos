{%- assign t_before = section.settings.title_before -%}
{%- assign t_italic = section.settings.title_italic -%}
{%- assign t_after = section.settings.title_after -%}

<section
  class="ing-section"
  id="ing-section-{{ section.id }}"
  aria-labelledby="ing-heading-{{ section.id }}"
>
  <div class="ing-section__container">

    {%- if t_before != blank or t_italic != blank or t_after != blank -%}
      <h2 class="ing-section__heading" id="ing-heading-{{ section.id }}">
        {%- if t_before != blank -%}{{ t_before | escape }}{%- endif -%}
        {%- if t_italic != blank -%} <em>{{ t_italic | escape }}</em>{%- endif -%}
        {%- if t_after != blank -%} {{ t_after | escape }}{%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ing-section__track-wrap">
        <ul class="ing-section__grid" id="ing-grid-{{ section.id }}">

          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient' -%}
              <li
                class="ing-section__card"
                {{ block.shopify_attributes }}
                data-ing-card
              >
                {%- if block.settings.name != blank -%}
                  <p class="ing-section__card-name">{{ block.settings.name | escape }}</p>
                {%- endif -%}

                <div class="ing-section__card-media">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 600 }}"
                      alt="{{ block.settings.name | escape }}"
                      loading="lazy"
                      class="ing-section__card-img"
                    >
                  {%- else -%}
                    <div class="ing-section__card-placeholder" aria-hidden="true">
                      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="32" cy="32" r="28" stroke="#c8c8c6" stroke-width="2"/>
                        <circle cx="32" cy="32" r="18" stroke="#c8c8c6" stroke-width="1.5" stroke-dasharray="4 3"/>
                        <circle cx="32" cy="32" r="6" fill="#c8c8c6" opacity="0.5"/>
                      </svg>
                    </div>
                  {%- endif -%}

                  <button
                    class="ing-section__toggle-btn"
                    type="button"
                    aria-expanded="false"
                    aria-controls="ing-body-{{ section.id }}-{{ forloop.index }}"
                    aria-label="{{ block.settings.name | escape }}"
                    data-toggle
                  >
                    <span class="ing-section__toggle-icon" aria-hidden="true">+</span>
                  </button>
                </div>

                <div
                  class="ing-section__card-body"
                  id="ing-body-{{ section.id }}-{{ forloop.index }}"
                  aria-hidden="true"
                >
                  {%- if block.settings.description != blank -%}
                    <p class="ing-section__card-body-text">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>

              </li>
            {%- endif -%}
          {%- endfor -%}

        </ul>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .ing-section {
    background-color: #ffffff;
    padding: 56px 20px 64px;
    box-sizing: border-box;
    width: 100%;
  }

  .ing-section__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ing-section__heading {
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 400;
    color: #1a1a1a;
    line-height: 1.25;
    margin: 0 0 40px;
    padding: 0;
    letter-spacing: -0.01em;
  }

  .ing-section__heading em {
    font-style: italic;
  }

  .ing-section__track-wrap {
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-mask-image: linear-gradient(to right, black 88%, transparent 100%);
    mask-image: linear-gradient(to right, black 88%, transparent 100%);
  }

  .ing-section__track-wrap::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 1024px) {
    .ing-section__track-wrap {
      overflow-x: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  .ing-section__grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    align-items: flex-start;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .ing-section__grid {
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1024px) {
    .ing-section__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding-bottom: 0;
    }
  }

  .ing-section__card {
    position: relative;
    background-color: #f5f5f3;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    width: 68vw;
    min-width: 200px;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    list-style: none;
    box-sizing: border-box;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .ing-section__card {
      width: calc(50% - 8px);
      min-width: 220px;
      max-width: none;
      flex-shrink: unset;
    }
  }

  @media (min-width: 1024px) {
    .ing-section__card {
      width: auto;
      min-width: unset;
      max-width: none;
      flex-shrink: unset;
    }
  }

  .ing-section__card-name {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1a1a1a;
    line-height: 1.35;
    padding: 14px 16px 10px;
    margin: 0;
  }

  .ing-section__card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #ededeb;
  }

  .ing-section__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ing-section__card-placeholder {
    width: 100%;
    height: 100%;
    background-color: #e5e5e3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ing-section__toggle-btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #0F6E56;
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.15s ease;
    z-index: 3;
    -webkit-appearance: none;
    appearance: none;
  }

  .ing-section__toggle-btn:hover {
    background-color: #1D9E75;
    transform: scale(1.08);
  }

  .ing-section__toggle-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(15, 110, 86, 0.35);
  }

  .ing-section__card.is-open .ing-section__toggle-btn {
    background-color: #1D9E75;
  }

  .ing-section__toggle-icon {
    font-size: 20px;
    font-weight: 300;
    line-height: 1;
    display: block;
  }

  .ing-section__card-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s ease, padding-top 0.3s ease, padding-bottom 0.3s ease;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .ing-section__card.is-open .ing-section__card-body {
    max-height: 500px;
    padding-top: 14px;
    padding-bottom: 52px;
  }

  .ing-section__card-body-text {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 13px;
    line-height: 1.7;
    color: #444444;
    margin: 0;
    padding: 0;
  }
</style>

<script>
(function () {
  var sectionEl = document.getElementById('ing-section-{{ section.id }}');
  if (!sectionEl) return;

  var grid = sectionEl.querySelector('#ing-grid-{{ section.id }}');
  if (!grid) return;

  var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-ing-card]'));

  function closeCard(card) {
    card.classList.remove('is-open');
    var btn  = card.querySelector('[data-toggle]');
    var icon = card.querySelector('.ing-section__toggle-icon');
    var body = card.querySelector('.ing-section__card-body');
    if (btn)  btn.setAttribute('aria-expanded', 'false');
    if (body) body.setAttribute('aria-hidden', 'true');
    if (icon) icon.textContent = '+';
  }

  function openCard(card) {
    card.classList.add('is-open');
    var btn  = card.querySelector('[data-toggle]');
    var icon = card.querySelector('.ing-section__toggle-icon');
    var body = card.querySelector('.ing-section__card-body');
    if (btn)  btn.setAttribute('aria-expanded', 'true');
    if (body) body.setAttribute('aria-hidden', 'false');
    if (icon) icon.textContent = '\u00D7';
  }

  cards.forEach(function (card) {
    var btn = card.querySelector('[data-toggle]');
    if (!btn) return;

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var wasOpen = card.classList.contains('is-open');
      cards.forEach(closeCard);
      if (!wasOpen) {
        openCard(card);
        if (window.innerWidth < 1024) {
          setTimeout(function () {
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          }, 60);
        }
      }
    });
  });

  sectionEl.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' || e.keyCode === 27) {
      cards.forEach(closeCard);
    }
  });

})();
</script>

{% schema %}
{
