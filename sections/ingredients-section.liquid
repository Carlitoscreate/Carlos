{%- assign t_before = section.settings.title_before -%}
{%- assign t_italic = section.settings.title_italic -%}
{%- assign t_after = section.settings.title_after -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<section class="ing-s" id="ing-s-{{ section.id }}">
  <div class="ing-s__container">

    {%- if t_before != blank or t_italic != blank or t_after != blank -%}
      <h2 class="ing-s__heading">
        {%- if t_before != blank -%}{{ t_before | escape }}{%- endif -%}
        {%- if t_italic != blank -%} <em>{{ t_italic | escape }}</em>{%- endif -%}
        {%- if t_after != blank -%} {{ t_after | escape }}{%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ing-s__track">
        <ul class="ing-s__grid" id="ing-s-grid-{{ section.id }}">

          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient' -%}
              <li class="ing-s__card" {{ block.shopify_attributes }} data-ing-card>
                <div class="ing-s__card-inner">

                  <div class="ing-s__card-front">
                    {%- if block.settings.name != blank -%}
                      <p class="ing-s__name">{{ block.settings.name | escape }}</p>
                    {%- endif -%}
                    <div class="ing-s__img-wrap">
                      {%- if block.settings.image != blank -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 600 }}"
                          alt="{{ block.settings.name | escape }}"
                          loading="lazy"
                          class="ing-s__img"
                        >
                      {%- else -%}
                        <div class="ing-s__placeholder">
                          <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="32" cy="32" r="28" stroke="#c8c8c6" stroke-width="2"/>
                            <circle cx="32" cy="32" r="18" stroke="#c8c8c6" stroke-width="1.5" stroke-dasharray="4 3"/>
                            <circle cx="32" cy="32" r="6" fill="#c8c8c6" opacity="0.5"/>
                          </svg>
                        </div>
                      {%- endif -%}
                    </div>
                    <button class="ing-s__btn" type="button" aria-label="{{ block.settings.name | escape }}" data-toggle>+</button>
                  </div>

                  <div class="ing-s__card-back">
                    {%- if block.settings.name != blank -%}
                      <p class="ing-s__name ing-s__name--back">{{ block.settings.name | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <p class="ing-s__desc">{{ block.settings.description | escape }}</p>
                    {%- endif -%}
                    <button class="ing-s__btn ing-s__btn--x" type="button" aria-label="Cerrar" data-toggle>&times;</button>
                  </div>

                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}

        </ul>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .ing-s {
    background: #ffffff;
    padding: 28px 20px 48px;
    box-sizing: border-box;
    width: 100%;
  }

  .ing-s__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ing-s__heading {
    text-align: center;
    font-family: 'Poppins', sans-serif !important;
    font-size: clamp(20px, 2.8vw, 32px) !important;
    font-weight: 600 !important;
    color: #1a1a1a;
    line-height: 1.25;
    margin: 0 0 20px;
    padding: 0;
    letter-spacing: -0.02em;
  }

  .ing-s__heading em {
    font-style: italic !important;
    font-weight: 400 !important;
    font-family: 'Poppins', sans-serif !important;
  }

  .ing-s__track {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ing-s__track::-webkit-scrollbar {
    display: none;
  }

  .ing-s__grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
    align-items: flex-start;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .ing-s__grid {
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1024px) {
    .ing-s__track {
      overflow-x: visible;
    }
    .ing-s__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding-bottom: 0;
    }
  }

  /* Card — perspective wrapper */
  .ing-s__card {
    flex-shrink: 0;
    width: 68vw;
    min-width: 200px;
    max-width: 300px;
    aspect-ratio: 5 / 6;
    perspective: 1000px;
    list-style: none;
    cursor: pointer;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .ing-s__card {
      width: calc(50% - 8px);
      min-width: 200px;
      max-width: none;
      flex-shrink: unset;
    }
  }

  @media (min-width: 1024px) {
    .ing-s__card {
      width: 100%;
      min-width: unset;
      max-width: none;
      flex-shrink: unset;
    }
  }

  /* Flip inner */
  .ing-s__card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(0.4, 0.2, 0.2, 1);
  }

  .ing-s__card.is-open .ing-s__card-inner {
    transform: rotateY(180deg);
  }

  /* Front and back shared */
  .ing-s__card-front,
  .ing-s__card-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 16px;
    overflow: hidden;
    background-color: #f5f5f3;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* Back: pre-rotated + padding for text */
  .ing-s__card-back {
    transform: rotateY(180deg);
    padding: 18px 18px 52px;
    overflow-y: auto;
    background-color: #3a3a3a;
  }

  /* Name */
  .ing-s__name {
    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
    padding: 16px 16px 0;
    margin: 0;
    flex-shrink: 0;
  }

  .ing-s__name--back {
    padding: 0 0 12px;
    font-size: 17px;
    font-weight: 600;
    color: #ffffff;
  }

  /* Image — contained with padding so card bg shows around it */
  .ing-s__img-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    position: relative;
  }

  .ing-s__img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
  }

  .ing-s__placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #ebebea;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Description */
  .ing-s__desc {
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    line-height: 1.75;
    color: #cccccc;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  /* Toggle button */
  .ing-s__btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #0F6E56;
    color: #ffffff;
    border: none;
    cursor: pointer;
    font-size: 20px;
    font-weight: 300;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.15s ease;
    z-index: 2;
    -webkit-appearance: none;
    appearance: none;
    font-family: 'Poppins', sans-serif;
  }

  .ing-s__btn:hover {
    background-color: #1D9E75;
    transform: scale(1.08);
  }

  .ing-s__btn--x {
    background-color: #ffffff;
    color: #3a3a3a;
  }

  .ing-s__btn--x:hover {
    background-color: #e0e0e0;
  }
</style>

<script>
(function () {
  var section = document.getElementById('ing-s-{{ section.id }}');
  if (!section) return;

  var grid = section.querySelector('#ing-s-grid-{{ section.id }}');
  if (!grid) return;

  var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-ing-card]'));

  function closeAll() {
    cards.forEach(function (c) { c.classList.remove('is-open'); });
  }

  cards.forEach(function (card) {
    var btns = Array.prototype.slice.call(card.querySelectorAll('[data-toggle]'));
    btns.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var wasOpen = card.classList.contains('is-open');
        closeAll();
        if (!wasOpen) {
          card.classList.add('is-open');
          if (window.innerWidth < 1024) {
            setTimeout(function () {
              card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            }, 60);
          }
        }
      });
    });
  });

  section.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' || e.keyCode === 27) { closeAll(); }
  });
})();
</script>

{% schema %}
{
  "name": "Ingredientes",
  "tag": "section",
  "class": "ing-s-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title_before",
      "label": "Titulo primera parte",
      "default": "Ingredientes con"
    },
    {
      "type": "text",
      "id": "title_italic",
      "label": "Titulo cursiva",
      "default": "ciencia real"
    },
    {
      "type": "text",
      "id": "title_after",
      "label": "Titulo ultima parte",
      "default": "detras"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediente",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Ingrediente"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripcion",
          "default": "Descripcion del ingrediente."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredientes",
      "blocks": [
        {"type": "ingredient", "settings": {"name": "Calostro Bovino", "description": "El primer alimento que da una madre a su cria. Regula el sistema inmune desde adentro."}},
        {"type": "ingredient", "settings": {"name": "Aceite de Salmon", "description": "Concentrado de Omega-3 EPA y DHA. Reduce la inflamacion y fortalece la barrera cutanea."}},
        {"type": "ingredient", "settings": {"name": "Omega-3", "description": "Los acidos grasos antiinflamatorios mas potentes. Mejoran la elasticidad de la piel."}},
        {"type": "ingredient", "settings": {"name": "Quercetina", "description": "El antihistaminico que la naturaleza ya invento. Corta el ciclo de picazon."}},
        {"type": "ingredient", "settings": {"name": "Probioticos", "description": "El 70 por ciento del sistema inmune vive en el intestino. Restauran el microbioma."}},
        {"type": "ingredient", "settings": {"name": "Vinagre de Sidra de Manzana", "description": "Acidifica el tracto digestivo y crea un ambiente hostil para bacterias y levaduras."}},
        {"type": "ingredient", "settings": {"name": "Hongo Reishi + Raiz de Regaliz", "description": "Escudo antifungico y antiinflamatorio natural. Combate infecciones recurrentes."}}
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}
